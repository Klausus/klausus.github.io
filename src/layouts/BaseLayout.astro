---
import '../styles/global.css';
import { profile } from '../data/profile';
import { getLocale, homePath, locales, tr, useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title = `${profile.name} (${profile.alias}) · ${profile.role}`,
  // los saltos de línea del resumen solo tienen sentido en la portada
  description = tr(profile.summary, locale).replace(/\s*\n\s*/g, ' '),
} = Astro.props;

// klausus.dev es el dominio principal; la copia de klausus.github.io apunta aquí
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const ogImageAlt = `${profile.name} (${profile.alias}) · ${profile.role} · klausus.dev`;
const isHome = Astro.url.pathname === homePath(locale) || Astro.url.pathname === homePath(locale).slice(0, -1);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#090b14" />
    <link rel="canonical" href={canonical} />
    {
      isHome && (
        <>
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(homePath(l), Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t('meta.locale')} />
    <meta property="og:site_name" content="klausus.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- imagen al compartir en LinkedIn, WhatsApp, X... (se regenera con `npm run og`) -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t('skip')}</a>
    <slot />
  </body>
</html>
