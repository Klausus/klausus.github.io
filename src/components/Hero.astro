---
import Terminal, { type Command } from './Terminal.vue';
import { currentJob, formatMonth, profile, socials } from '../data/profile';
import { getLocale, tr, useTranslations } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// iconos de Simple Icons (simpleicons.org)
const icons: Record<string, { name: string; path: string }> = {
  linkedin: {
    name: 'LinkedIn',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.91v5.431zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  github: {
    name: 'GitHub',
    path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
};

const commands: Command[] = [
  { cmd: 'whoami', output: [{ text: t('terminal.whoami') }] },
  { cmd: 'cat stack.txt', output: [{ text: profile.terminalStack }] },
];

if (currentJob) {
  const where = [currentJob.company, currentJob.location].filter(Boolean).join(' · ');
  commands.push({
    cmd: 'job --current',
    output: [
      { text: `${tr(currentJob.role, locale)} @ ${where}` },
      { text: `${formatMonth(currentJob.start, locale)} → `, highlight: t('terminal.present'), muted: true },
    ],
  });
}
---

<section id="inicio" class="container hero">
  <div class="intro">
    <p class="tagline mono">{profile.tagline}</p>
    <h1>{profile.name}</h1>
    <p class="alias">{profile.aliasJp} | {profile.alias}</p>
    <p class="summary">{tr(profile.summary, locale)}</p>
    <div class="actions">
      <div class="buttons">
        <a href="#proyectos" class="btn btn-primary">{t('hero.projects')}</a>
        {profile.cvUrl && <a href={tr(profile.cvUrl, locale)} class="btn btn-ghost" download>{t('hero.cv')}</a>}
      </div>
      <div class="social-icons">
        {
          socials
            .filter((social) => icons[social.label])
            .map((social) => (
              <a
                href={social.url}
                class="icon-btn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={icons[social.label].name}
                title={icons[social.label].name}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={icons[social.label].path} />
                </svg>
              </a>
            ))
        }
      </div>
    </div>
  </div>
  <Terminal client:load commands={commands} />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 56px;
    align-items: center;
    padding-block: 96px 110px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .tagline {
    font-size: 13px;
    color: var(--cyan);
    letter-spacing: 0.1em;
    overflow-wrap: anywhere;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 6vw, 60px);
    line-height: 1.05;
    text-transform: uppercase;
    text-shadow: 0 0 18px rgba(34, 225, 240, 0.55);
    overflow-wrap: anywhere;
  }

  .alias {
    font-family: var(--font-jp);
    font-weight: 700;
    font-size: clamp(24px, 4vw, 34px);
    letter-spacing: 0.2em;
    color: var(--neon);
    text-shadow: 0 0 16px var(--neon);
  }

  .summary {
    max-width: 540px;
    color: var(--muted);
    /* respeta los saltos de línea (\n) del texto */
    white-space: pre-line;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }

  /* si los dos botones no caben en una línea (móviles pequeños), se reparten
     en dos líneas centradas; si caben, el bloque se ajusta a su contenido y
     el centrado no se nota */
  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .social-icons {
    display: flex;
    gap: 14px;
  }

  /* cuadrados del mismo alto que los botones */
  .icon-btn {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border: 1px solid var(--line);
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .icon-btn svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .icon-btn:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 18px rgba(34, 225, 240, 0.4);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 56px 72px;
      gap: 40px;
    }

    /* en móvil, los iconos centrados en su propia línea debajo de los botones y en orden inverso (GitHub, LinkedIn) */
    .social-icons {
      flex-basis: 100%;
      justify-content: center;
      flex-direction: row-reverse;
    }
  }
</style>
