---
import Section from './Section.astro';
import { education, experience, logTitle, yearRange } from '../data/profile';
import { getLocale, tr, useTranslations } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Section id="experiencia" number="03" jp="経歴" title={t('section.career')} watermark="経歴">
  <ol class="log mono">
    {
      experience.map((job) => (
        <li class:list={{ current: job.end === null }}>
          <span class="range">[{yearRange(job)}]</span>
          <span class="entry">
            <strong>{logTitle(tr(job.role, locale), job.company)}</strong>
            {job.end === null && <span class="now jp">現在</span>}
            {job.tag && <span class="tag">{tr(job.tag, locale)}</span>}
            <br />
            <span class="description">{tr(job.description, locale)}</span>
            {job.stack && <><br /><span class="description">{job.stack}</span></>}
          </span>
        </li>
      ))
    }
  </ol>
  <p class="education mono">
    学歴 EDU: {tr(education.degree, locale)} · 資格 CERT: {tr(education.cert, locale)}
  </p>
</Section>

<style>
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line-soft);
  }

  li:last-child {
    border-bottom: 0;
  }

  li.current {
    background: rgba(34, 225, 240, 0.08);
    border: 1px solid rgba(34, 225, 240, 0.4);
  }

  .range {
    flex: 0 0 170px;
    color: var(--dim);
  }

  .current .range {
    color: var(--cyan);
  }

  .entry {
    flex: 1 1 360px;
    min-width: 0;
  }

  strong {
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .now {
    margin-left: 8px;
    padding: 1px 8px;
    font-size: 12px;
    color: var(--bg);
    background: var(--neon);
  }

  .tag {
    display: inline-block;
    margin-left: 8px;
    padding: 0 8px;
    font-size: 12px;
    color: var(--cyan);
    border: 1px solid var(--cyan);
  }

  .description {
    color: var(--muted);
  }

  .education {
    font-size: 13px;
    color: var(--dim);
  }
</style>
